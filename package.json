{
  "name": "promptcad",
  "version": "0.0.0",
  "description": "A client-only React PWA where an LLM writes OpenSCAD, the browser compiles it with OpenSCAD WASM, and you iterate by chat, code, sliders, 3D picking or images, then export STL. No backend: keys, projects and history stay on your device.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tokens": "tsx scripts/gen-tokens.ts",
    "fetch:openscad": "tsx scripts/fetch-openscad.ts",
    "predev": "tsx scripts/fetch-openscad.ts --if-missing",
    "prebuild": "tsx scripts/fetch-openscad.ts --if-missing"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meyhem/promptcad.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Meyhem/promptcad/issues"
  },
  "homepage": "https://github.com/Meyhem/promptcad#readme",
  "private": "true",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "comlink": "^4.4.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
